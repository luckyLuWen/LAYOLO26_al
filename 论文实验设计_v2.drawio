        <mxCell id="sum3" value="第三组：泛化实验 → 实际部署价值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#FB8C00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="642" width="200" height="26" as="geometry" />
